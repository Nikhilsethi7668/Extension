{
  "name": "flash-fender-auto-poster-windows",
  "version": "1.0.0",
  "description": "Desktop app for automated vehicle posting to Facebook Marketplace (Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder --win --x64"
  },
  "author": "Flash Fender",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "puppeteer": "^21.0.0",
    "puppeteer-core": "^21.0.0",
    "smart-buffer": "^4.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.flashfender.autoposter",
    "productName": "Flash Fender Auto-Poster",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "icon.png",
      "bundleVersion": "1.0.0",
      "minimumSystemVersion": "10.13.0",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "type": "distribution"
    },
    "dmg": {
      "title": "Flash Fender Auto-Poster ${version}",
      "icon": "icon.png",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "sign": null,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!**/*.md",
      "!.gitignore",
      "!dist",
      "!.git"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
